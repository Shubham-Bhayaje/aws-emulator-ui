{
  "name": "aws-emulator-ui",
  "version": "0.1.0",
  "description": "Unofficial open-source web UI and local dashboard for the official AWS Emulator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shubham-Bhayaje/aws-emulator-ui.git"
  },
  "homepage": "https://github.com/Shubham-Bhayaje/aws-emulator-ui#readme",
  "bugs": {
    "url": "https://github.com/Shubham-Bhayaje/aws-emulator-ui/issues"
  },
  "keywords": [
    "aws",
    "aws-emulator",
    "dashboard",
    "web-ui",
    "local-aws",
    "localstack-alternative",
    "devtools",
    "local-development",
    "s3",
    "sqs",
    "dynamodb",
    "iam",
    "nextjs",
    "react"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:bash": "NODE_EXTRA_CA_CERTS=$HOME/.aws/emulator/9297/ca.pem AWS_SHARED_CREDENTIALS_FILE=$HOME/.aws/emulator/9297/emulator_credentials AWS_CONFIG_FILE=$HOME/.aws/emulator/9297/config AWS_EC2_METADATA_DISABLED=true next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-account": "^3.1173.0",
    "@aws-sdk/client-acm": "^3.1175.0",
    "@aws-sdk/client-acm-pca": "^3.1175.0",
    "@aws-sdk/client-auto-scaling": "^3.1171.0",
    "@aws-sdk/client-dynamodb": "^3.1170.0",
    "@aws-sdk/client-ec2": "^3.1171.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1171.0",
    "@aws-sdk/client-iam": "^3.1170.0",
    "@aws-sdk/client-kms": "^3.1172.0",
    "@aws-sdk/client-lambda": "^3.1171.0",
    "@aws-sdk/client-organizations": "^3.1172.0",
    "@aws-sdk/client-ram": "^3.1173.0",
    "@aws-sdk/client-resource-groups": "^3.1173.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1173.0",
    "@aws-sdk/client-route-53": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/client-secrets-manager": "^3.1175.0",
    "@aws-sdk/client-service-quotas": "^3.1173.0",
    "@aws-sdk/client-sqs": "^3.1170.0",
    "@aws-sdk/client-ssm": "^3.1175.0",
    "@aws-sdk/client-sts": "^3.1170.0",
    "@aws-sdk/credential-providers": "^3.1170.0",
    "jszip": "^3.10.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
