FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Install standard Linux development, networking, diagnostic utilities, and common tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    bash \
    curl \
    wget \
    git \
    vim \
    nano \
    htop \
    procps \
    net-tools \
    iproute2 \
    iputils-ping \
    dnsutils \
    ca-certificates \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    unzip \
    tar \
    gzip \
    jq \
    openssh-client \
    locales \
    fish \
    nginx \
    tree \
    tmux \
    zsh \
    && locale-gen en_US.UTF-8 \
    && apt-get clean \
    && apt-get update

# Ensure ubuntu user exists with passwordless sudo permissions
RUN if ! id -u ubuntu >/dev/null 2>&1; then \
        useradd -m -s /bin/bash -u 1000 ubuntu; \
    fi && \
    echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-cloud-init-users && \
    chmod 0440 /etc/sudoers.d/90-cloud-init-users

WORKDIR /home/ubuntu
USER ubuntu
ENV HOME=/home/ubuntu
ENV USER=ubuntu

CMD ["tail", "-f", "/dev/null"]
